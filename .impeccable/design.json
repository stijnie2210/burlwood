  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single blue action in a context, e.g. Commit.",
      "html": "<button class=\"ds-btn-primary\">Commit to <strong>main</strong></button>",
      "css": ".ds-btn-primary{width:240px;padding:8px;border:none;border-radius:5px;background:var(--accent-fill,#2f6fdc);color:#fff;font:500 12px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;cursor:pointer;transition:background .15s}.ds-btn-primary:hover{background:var(--accent-fill-hover,#2a66cc)}.ds-btn-primary:focus-visible{outline:2px solid var(--focus-ring,#5aa5ff);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Neutral control fill for everything that is not the primary action.",
      "html": "<button class=\"ds-btn-secondary\">Type a message to commit</button>",
      "css": ".ds-btn-secondary{width:240px;padding:8px;border:none;border-radius:5px;background:var(--surface-control,#3a3632);color:var(--text-secondary,#c6c0b8);font:500 12px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;cursor:pointer}.ds-btn-secondary:hover{background:var(--surface-control-hover,#44403b)}.ds-btn-secondary:focus-visible{outline:2px solid var(--focus-ring,#5aa5ff);outline-offset:2px}"
    },
    {
      "name": "Destructive Confirmation",
      "kind": "custom",
      "refersTo": "button-destructive",
      "description": "In-menu confirmation that names the consequence before a destructive step.",
      "html": "<div class=\"ds-confirm\"><p>\"feature/x\" has commits that aren't merged into any other branch. Force deleting it leaves them reachable only through the reflog.</p><div class=\"ds-row\"><button class=\"ds-danger\">Force delete</button><button class=\"ds-plain\">Keep branch</button></div></div>",
      "css": ".ds-confirm{width:250px;padding:8px 10px;background:var(--surface-overlay,#2f2c28);border:1px solid var(--border,#3e3a35);border-radius:6px;box-shadow:0 8px 24px rgba(0,0,0,.5);font-family:-apple-system,BlinkMacSystemFont,system-ui,sans-serif}.ds-confirm p{margin:0 0 8px;font-size:11px;line-height:1.4;color:var(--danger,#ff7b72)}.ds-row{display:flex;gap:6px}.ds-danger,.ds-plain{flex:1;padding:4px 0;border:none;border-radius:4px;font-size:12px;cursor:pointer}.ds-danger{background:var(--danger-fill,#c42f2a);color:#fff;font-weight:600}.ds-danger:hover{background:var(--danger-fill-hover,#b02824)}.ds-plain{background:var(--surface-control,#3a3632);color:var(--text-secondary,#c6c0b8)}.ds-plain:hover{background:var(--surface-control-hover,#44403b)}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Commit summary and inline name inputs.",
      "html": "<input class=\"ds-input\" placeholder=\"Commit summary\" />",
      "css": ".ds-input{width:240px;padding:6px 8px;background:var(--surface-field,#171513);border:1px solid var(--border,#3e3a35);border-radius:4px;color:var(--text-primary,#ede9e4);font:12px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;outline:none}.ds-input::placeholder{color:var(--text-tertiary,#b3aca2)}.ds-input:focus{border-color:var(--focus-ring,#5aa5ff)}"
    },
    {
      "name": "Context Menu",
      "kind": "nav",
      "refersTo": "menu",
      "description": "Teleported right-click menu; rows highlight in system blue.",
      "html": "<div class=\"ds-menu\"><div class=\"ds-menu-label\">a1b2c3d — Fix graph lanes</div><button class=\"ds-item\">Copy short SHA</button><button class=\"ds-item\">Create branch here…</button><div class=\"ds-div\"></div><button class=\"ds-item ds-danger-item\">Hard — discard all changes</button></div>",
      "css": ".ds-menu{width:230px;padding:4px 0;background:var(--surface-overlay,#2f2c28);border:1px solid var(--border,#3e3a35);border-radius:6px;box-shadow:0 8px 24px rgba(0,0,0,.5);font-family:-apple-system,BlinkMacSystemFont,system-ui,sans-serif}.ds-menu-label{padding:5px 12px;font:11px ui-monospace,'SF Mono',Menlo,monospace;color:var(--text-tertiary,#b3aca2)}.ds-item{display:block;width:100%;padding:6px 12px;border:none;background:none;text-align:left;font-size:12px;color:var(--text-primary,#ede9e4);cursor:pointer}.ds-item:hover,.ds-item:focus-visible{background:var(--accent-fill,#2f6fdc);color:#fff;outline:none}.ds-danger-item{color:var(--danger,#ff7b72)}.ds-div{height:1px;margin:3px 0;background:var(--border-subtle,#312e2a)}"
    },
    {
      "name": "Ref Labels",
      "kind": "chip",
      "refersTo": "label-branch",
      "description": "Refs in the commit list: HEAD filled with a check, branches outlined in blue, remotes with a cloud, tags with a tag mark, stashes in lilac.",
      "html": "<span class=\"ds-l ds-head\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>main</span> <span class=\"ds-l ds-branch\">feature/sync</span> <span class=\"ds-l ds-remote\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9z\"/></svg>origin/main</span> <span class=\"ds-l ds-tag\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 2H2v10l9.3 9.3a1 1 0 0 0 1.4 0l8.6-8.6a1 1 0 0 0 0-1.4z\"/><circle cx=\"7\" cy=\"7\" r=\"1.5\"/></svg>v0.2.0</span> <span class=\"ds-l ds-stash\">stash@{0}</span>",
      "css": ".ds-l{display:inline-flex;align-items:center;gap:3px;height:18px;padding:0 6px;border-radius:4px;border:1px solid transparent;box-sizing:border-box;font:500 11px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;white-space:nowrap}.ds-head{background:var(--accent-fill,#2f6fdc);color:#fff;font-weight:600}.ds-branch{color:var(--accent-text,#5aa5ff);border-color:rgba(90,165,255,.4)}.ds-remote{color:var(--text-tertiary,#b3aca2);border-color:var(--border-strong,#4e4943);font-weight:400}.ds-tag{background:rgba(227,179,65,.14);color:var(--tag,#e3b341);border-color:rgba(227,179,65,.35)}.ds-stash{background:rgba(190,150,239,.14);color:var(--stash,#be96ef);border-color:rgba(190,150,239,.35)}"
    },
    {
      "name": "Diff Lines",
      "kind": "custom",
      "description": "Signature component: SF Mono diff on the Gauge Face; the changed words of a paired line get a stronger wash.",
      "html": "<div class=\"ds-diff\"><div class=\"ds-dl\"><span class=\"ds-n\">4</span><span class=\"ds-n\">4</span><span class=\"ds-g\"></span><span class=\"ds-c\">&lt;p align=\"center\"&gt;</span></div><div class=\"ds-dl ds-del\"><span class=\"ds-n\">5</span><span class=\"ds-n\"></span><span class=\"ds-g\">−</span><span class=\"ds-c\">&lt;h1&gt;<mark>gitgood</mark>&lt;/h1&gt;</span></div><div class=\"ds-dl ds-add\"><span class=\"ds-n\"></span><span class=\"ds-n\">5</span><span class=\"ds-g\">+</span><span class=\"ds-c\">&lt;h1&gt;<mark>Burlwood</mark>&lt;/h1&gt;</span></div></div>",
      "css": ".ds-diff{background:var(--surface-sunken,#141210);font:12px/19px ui-monospace,'SF Mono',Menlo,monospace;padding:6px 0;min-width:360px}.ds-dl{display:flex}.ds-n{width:44px;padding-right:8px;text-align:right;color:var(--text-tertiary,#b3aca2);font-size:11px;user-select:none}.ds-g{width:16px;text-align:center;color:var(--text-tertiary,#b3aca2)}.ds-c{padding:0 16px 0 4px;white-space:pre;color:var(--text-secondary,#c6c0b8)}.ds-add{background:rgba(79,201,119,.09)}.ds-add .ds-g{color:#4fc977}.ds-add .ds-c{color:#b6ecc6}.ds-del{background:rgba(255,123,114,.09)}.ds-del .ds-g{color:#ff7b72}.ds-del .ds-c{color:#ffbdb7}.ds-c mark{color:inherit;border-radius:2px}.ds-add mark{background:rgba(79,201,119,.3)}.ds-del mark{background:rgba(255,123,114,.3)}"
    },
    {
      "name": "Toolbar Button Group",
      "kind": "nav",
      "description": "Icon-only toolbar buttons grouped by task on a raised capsule; each has a tooltip and an accessible name.",
      "html": "<div class=\"ds-tbgroup\"><button class=\"ds-tbtn\" title=\"Fetch (⌘R)\" aria-label=\"Fetch\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"4\" y1=\"3\" x2=\"14\" y2=\"3\"/><line x1=\"9\" y1=\"5\" x2=\"9\" y2=\"13\"/><polyline points=\"5,10 9,14 13,10\"/></svg></button><button class=\"ds-tbtn\" title=\"Pull\" aria-label=\"Pull\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"9\" y1=\"3\" x2=\"9\" y2=\"13\"/><polyline points=\"5,9 9,14 13,9\"/></svg></button><button class=\"ds-tbtn\" title=\"Push\" aria-label=\"Push\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"9\" y1=\"15\" x2=\"9\" y2=\"5\"/><polyline points=\"5,9 9,4 13,9\"/></svg></button></div>",
      "css": ".ds-tbgroup{display:inline-flex;gap:2px;padding:2px;border-radius:8px;background:var(--surface-raised,#211f1c)}.ds-tbtn{display:flex;align-items:center;justify-content:center;width:34px;height:28px;padding:0;border:none;border-radius:6px;background:transparent;color:var(--text-secondary,#c6c0b8);cursor:default;transition:background .1s,color .1s}.ds-tbtn:hover{background:rgba(255,240,220,.06);color:var(--text-primary,#ede9e4)}.ds-tbtn:focus-visible{outline:2px solid var(--focus-ring,#5aa5ff);outline-offset:-2px}"
    },
    {
      "name": "HEAD Knot",
      "kind": "custom",
      "description": "The checked-out commit in the graph, drawn as the app icon's knot: a heartwood core in a sapwood ring, with a gap that interrupts the lane.",
      "html": "<div class=\"ds-lane\"><span class=\"ds-dot\"></span><span class=\"ds-knot\"></span><span class=\"ds-dot\"></span></div>",
      "css": ".ds-lane{position:relative;display:flex;flex-direction:column;align-items:center;gap:20px;width:14px;padding:10px 0;background:linear-gradient(#6aa5f0,#6aa5f0) center/2px 100% no-repeat}.ds-dot{width:8px;height:8px;border-radius:50%;background:#6aa5f0;box-shadow:0 0 0 1.5px var(--surface-base,#1a1816)}.ds-knot{width:12px;height:12px;border-radius:50%;box-sizing:border-box;background:var(--brand-heartwood,#2a1a10);border:2.25px solid var(--brand-sapwood,#f3ddb8);box-shadow:0 0 0 1.5px var(--surface-base,#1a1816)}"
    },
    {
      "name": "Welcome Wordmark",
      "kind": "custom",
      "description": "The lowercase wordmark on the welcome screen, the only place the brand typeface and Sapwood text appear.",
      "html": "<div class=\"ds-welcome\"><h1 class=\"ds-wordmark\">burlwood</h1><p class=\"ds-lede\">Open a repository to get started.</p></div>",
      "css": ".ds-welcome{text-align:center;padding:16px}.ds-wordmark{margin:0;font:600 44px/1 'Burlwood Wordmark','Bricolage Grotesque',-apple-system,BlinkMacSystemFont,system-ui,sans-serif;letter-spacing:-.02em;color:var(--brand-sapwood,#f3ddb8)}.ds-lede{margin:12px 0 0;font:400 15px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;color:var(--text-secondary,#c6c0b8)}"
    }
  ],
  "narrative": {
    "northStar": "The Instrument Panel, Burl-Trimmed",
    "overview": "Burlwood is where a developer reads what happened and decides what happens next. Picture the dashboard of a classic car: the instruments are dark, precise and legible at a glance, and the burl wood frames them without ever covering a dial. Here the instruments are the commit history, diffs and conflicts; everything around them is housing. The instruments must stay quiet and steady enough to read for hours, so the housing uses macOS's own vocabulary (system fonts, system-blue actions, blue-highlighted menus) and sits at home next to Xcode and Finder. Its surfaces are warm graphite. The wood itself is trim: it appears only where nothing has to be read, as described in The Veneer Rule.\n\nColour is reserved for meaning. A green line was added and a red line was removed. Orange is a modified file. Blue is the thing you can act on. If a colour does not carry one of those meanings, it should not be there. The UI is dense because git work is dense, but it is never cramped: text stays at or above 11px, every text level clears 4.5:1 contrast, and code gets its own monospace voice.\n\nDestructive operations are guarded switches: they name their consequence and can be undone where git allows (discard and hard reset show an Undo toast). Anything that can't be undone, such as force-pushing or force-deleting, gets its own explicit, red-filled step.",
    "keyCharacteristics": [
      "Warm graphite surfaces layered by tone, not by borders or shadows",
      "One accent (system blue) for actions, focus and selection",
      "Git semantics own the remaining colour: add, delete, modified, untracked, ours/theirs, tag, stash",
      "SF Pro for the interface, SF Mono for anything copied from or into git",
      "Four text sizes, no decorative type"
    ],
    "rules": [
      {
        "name": "The System Accent Rule",
        "body": "Never hard-code the accent: derive fills, text, focus and selection from `--accent-system` with `color-mix`, so the app follows the user's System Settings.",
        "section": "colors"
      },
      {
        "name": "The Key Window Rule",
        "body": "Selection is accent-tinted only while the window is key; `html.window-inactive` turns it grey.",
        "section": "colors"
      },
      {
        "name": "The Meaning-Only Rule",
        "body": "Every hue in the interface must map to a git state or an action. A new colour needs a new meaning.",
        "section": "colors"
      },
      {
        "name": "The No-Shared-Red Rule",
        "body": "Red means removal or destruction, never a neutral action. Unstage is blue, not red. Graph lanes never use the add or delete hues.",
        "section": "colors"
      },
      {
        "name": "The Token Rule",
        "body": "Components use `var(--token)` from `frontend/src/style.css`. A hex value in a component is a bug.",
        "section": "colors"
      },
      {
        "name": "The Veneer Rule",
        "body": "Burl wood is trim, not structure: the work surfaces stay neutral and the brand appears in exactly two places. Sapwood (brand-sapwood) and Heartwood (brand-heartwood) draw the checked-out commit in the graph as the knot from the app icon, a heartwood core in a sapwood ring, and Sapwood colours the welcome wordmark. Brand colours never mark git state, so they never appear in lists, labels or diffs.",
        "section": "colors"
      },
      {
        "name": "The Four Sizes Rule",
        "body": "Text uses `--text-meta`, `--text-row`, `--text-body` or `--text-title`. The only exceptions are the 44px welcome wordmark and 16px glyph icons.",
        "section": "typography"
      },
      {
        "name": "The Real Mono Rule",
        "body": "Never write bare `monospace`; WKWebView maps it to Courier. Use `var(--font-mono)`.",
        "section": "typography"
      },
      {
        "name": "The Floaters-Only Rule",
        "body": "A shadow means \"this is above the window and will go away\". Inline content, including image previews, gets a hairline border instead.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the default arrow cursor on controls (macOS has no hand cursor on buttons); only resize handles change the cursor.",
      "**Do** use the semantic tokens in `style.css` for every colour, size and shadow.",
      "**Do** give each context one blue primary action and make everything else neutral.",
      "**Do** name the consequence in any destructive confirmation (\"leaves them reachable only through the reflog\").",
      "**Do** offer Undo where git can restore the state, and an explicit red step where it can't.",
      "**Do** keep metadata at tertiary text or brighter; check 4.5:1 on the lightest surface it can appear on (overlay)."
    ],
    "donts": [
      "**Don't** introduce navy or coloured backgrounds; surfaces stay warm graphite.",
      "**Don't** use green or red for anything other than add/delete (plus ours and destructive actions).",
      "**Don't** use uppercase letter-spaced micro-labels; labels are 11px semibold in sentence case.",
      "**Don't** put shadows on inline content; only popovers and modals float.",
      "**Don't** rely on inherited centring; alignment is left unless a rule centres explicitly."
    ]
  }
}
