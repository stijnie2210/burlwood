      "css": ".ds-btn-secondary{width:240px;padding:8px;border:none;border-radius:5px;background:var(--surface-control,#38383c);color:var(--text-secondary,#c0c0c5);font:500 12px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;cursor:pointer}.ds-btn-secondary:hover{background:var(--surface-control-hover,#424246)}.ds-btn-secondary:focus-visible{outline:2px solid var(--focus-ring,#5aa5ff);outline-offset:2px}"
