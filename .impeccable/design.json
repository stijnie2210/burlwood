      "description": "Commit summary and inline name inputs.",
      "html": "<input class=\"ds-input\" placeholder=\"Commit summary\" />",
      "css": ".ds-input{width:240px;padding:6px 8px;background:var(--surface-field,#19191b);border:1px solid var(--border,#3c3c40);border-radius:4px;color:var(--text-primary,#e8e8ea);font:12px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;outline:none}.ds-input::placeholder{color:var(--text-tertiary,#a1a1a6)}.ds-input:focus{border-color:var(--focus-ring,#5aa5ff)}"
    },
    {
